# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_ANON_KEY: Your Supabase anonymous API key
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Server-only secret (service_role). Never expose to the browser.
# Used by /api/send-campaign and /api/storage/* (upload/signed-url) on the server.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# STORAGE_ABORT_SECRET: Server-only HMAC secret for upload cleanup tokens.
# Never expose to the browser. Use a long random string (at least 32 characters).
# Do not reuse SUPABASE_SERVICE_ROLE_KEY or other existing secrets.
STORAGE_ABORT_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# RESEND_API_KEY: Your Resend API key for sending emails
RESEND_API_KEY="re_your_api_key_here"

